# =============================================================================
# ONE project .htaccess — clean URLs → single front controller
#
# Requires Apache mod_rewrite (enable in MAMP: uncomment LoadModule rewrite_module).
#
#   /purchase-entry-track/report
#   /purchase-entry-track/report/   → 302 → /report (no 500 loop)
#   POST /purchase-entry-track/store
# =============================================================================

DirectoryIndex index.php
DirectorySlash On
Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    <Files "bootstrap.php">
        Require all denied
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <Files "bootstrap.php">
        Deny from all
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^index\.php(?:/.*)?$ - [L]
    RewriteRule ^public(/|$) - [L]

    RewriteRule ^(app|config|database|routes|tests|vendor)(/|$) - [F,L]
    RewriteRule ^bootstrap\.php$ - [F,L]

    # Front controller for clean routes (/report, /store, /install, …)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Last resort when rewrite module is not loaded (shared hosts / misconfigured MAMP).
# Do not combine with DirectorySlash tricks that loop on /report/.
<IfModule !mod_rewrite.c>
    FallbackResource index.php
</IfModule>
