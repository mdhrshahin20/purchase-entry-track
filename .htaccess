# =============================================================================
# ONE project .htaccess — single front controller (index.php)
#
# Routes live only in routes/web.php. Do NOT add report/, store/, install/ folders.
# Links use PATH_INFO: /index.php/report (works without rewrite on LiteSpeed).
# Optional pretty URLs (/report) when rewrite is available.
# =============================================================================

DirectoryIndex index.php
DirectorySlash On
Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    <Files "bootstrap.php">
        Require all denied
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <Files "bootstrap.php">
        Deny from all
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow /index.php/report (PATH_INFO)
    RewriteRule ^index\.php(?:/.*)?$ - [L]

    RewriteRule ^public(/|$) - [L]

    RewriteRule ^(app|config|database|routes|tests|vendor)(/|$) - [F,L]
    RewriteRule ^bootstrap\.php$ - [F,L]

    # Optional pretty URLs when the host supports rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>
