# =============================================================================
# Clean URLs → single front controller (no report/store folders)
#
#   /report  /store  /install
# =============================================================================

DirectoryIndex index.php
DirectorySlash On
Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    <Files "bootstrap.php">
        Require all denied
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <Files "bootstrap.php">
        Deny from all
    </Files>
</IfModule>

# If rewrite is ignored (some LiteSpeed), still hand missing URLs to PHP.
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^index\.php(?:/.*)?$ - [L]
    RewriteRule ^public(/|$) - [L]
    RewriteRule ^(app|config|database|routes|tests|vendor)(/|$) - [F,L]
    RewriteRule ^bootstrap\.php$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>
