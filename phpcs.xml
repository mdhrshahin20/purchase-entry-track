<?xml version="1.0"?>
<ruleset name="PurchaseEntry">
    <description>PSR-12 coding standard for Purchase Entry MVC</description>

    <file>app</file>
    <file>public/index.php</file>
    <file>config</file>
    <file>tests</file>

    <exclude-pattern>*/Views/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="PSR12"/>

    <arg name="colors"/>
    <arg value="p"/>
    <arg name="parallel" value="75"/>
</ruleset>
